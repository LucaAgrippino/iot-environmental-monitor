# IDE
.vscode/
.settings/
*.launch
# CubeIDE per-machine project files (paths and exclusions are machine-specific)
.cproject
.project

# Build artifacts
build/
Debug/
Release/
*.o
*.elf
*.bin
*.hex
*.map
*.lst

# OS files
.DS_Store
Thumbs.db

# Visual Paradigm backups
*.vpp.bak_*
*.vpp.lck

# Temporary working files
temp/
tmp/

# Local-only test infrastructure (contains private key material — never commit)
local-test/

.claude/

# Ceedling / CMock generated
tests/build/
tests/build/test/mocks/
tests/build_gateway/

# Generated firmware sources
firmware/shared/firmware_version.h

# Auto-generated bring-up certs (DER arrays + PEM copies, contains private
# key material — regenerate via
# local-test/mosquitto-broker/regenerate-bringup-certs.ps1)
firmware/gateway/certs/

# CubeIDE build outputs
firmware/**/Debug/
firmware/**/Release/
firmware/**/.settings/
firmware/**/*.launch

# Python
__pycache__/
*.pyc

# Private dev-tools — bug answer keys and interview tests must not be published
docs/dev-tools/bug-log.md
docs/dev-tools/interview-tests/


# CMake intermediate artefacts (if ever generated at repo root)
/build/
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake

# Docker / WSL editor scratch
.docker/
*.swp
*.swo

# CubeIDE headless build scratch (when invoked from /tmp)
/.metadata/