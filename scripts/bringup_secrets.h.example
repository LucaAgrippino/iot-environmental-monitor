/**
 * @file bringup_secrets.h.example
 * @brief Template for firmware/gateway/certs/bringup_secrets.h (gitignored,
 *        never committed).
 *
 * Copy this file to firmware/gateway/certs/bringup_secrets.h and fill in
 * real values. That folder is already on both Debug and Release Include
 * paths in firmware/gateway/.cproject (same folder bringup_certs.h uses),
 * so "bringup_secrets.h" resolves with no extra project configuration.
 *
 * This file is only pulled into a bring-up main when BRINGUP_TEST_MODE is
 * defined as a **compiler preprocessor symbol** — CubeIDE: Project
 * Properties -> C/C++ Build -> Settings -> MCU GCC Compiler -> Preprocessor
 * -> Defined symbols, add BRINGUP_TEST_MODE. Do not add
 * "#define BRINGUP_TEST_MODE" to any bring-up .c file — the whole point is
 * that toggling real-vs-placeholder builds never touches tracked source.
 * Leave the symbol undefined for a placeholder-only build.
 *
 * Covers every Gateway bring-up main's personal/environment-specific
 * values:
 *   - main_test_wifi_driver.c, main_test_wifi_task.c: WiFi AP credentials
 *     + the TCP/UDP peer host (phone server/listener app) for the socket
 *     round-trip tests.
 *   - main_test_mqtt_client.c, main_test_cloud_publisher.c: same WiFi AP
 *     credentials. The MQTT broker endpoint + TLS DER cert arrays are
 *     handled separately by bringup_certs.h (auto-generated by
 *     scripts/regenerate-bringup-certs.ps1 — see
 *     scripts/regenerate-bringup-certs-usage.txt) and pulled in
 *     automatically when present; nothing to add here for that part.
 */

#ifndef BRINGUP_SECRETS_H
#define BRINGUP_SECRETS_H

/* WiFi AP credentials — all four Gateway bring-up mains. */
#define BRINGUP_WIFI_SSID     "your-network-name"
#define BRINGUP_WIFI_PASSWORD "your-network-password"

/* TCP/UDP peer (phone server/listener app, or any listener) on the same
 * network — main_test_wifi_driver.c / main_test_wifi_task.c's socket
 * round-trip tests (TC-HW-WIFI-005/006, TC-HW-WIFITASK-005/006). */
#define BRINGUP_REMOTE_HOST "192.168.1.100"

#endif /* BRINGUP_SECRETS_H */
