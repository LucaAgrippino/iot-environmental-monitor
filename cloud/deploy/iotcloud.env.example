# /etc/iotcloud/iotcloud.env : settings of the cloud service (readable by root and the iotcloud user only)
IOTCLOUD_DB=/var/lib/iotcloud/iotcloud.sqlite3
IOTCLOUD_IMAGE_DIR=/var/lib/iotcloud/images
IOTCLOUD_WEB_DIR=/opt/iotcloud/web
IOTCLOUD_AUTH=on
# Caddy terminates HTTPS in front of this service: the session cookie must then never travel over plain http
IOTCLOUD_COOKIE_SECURE=on

# The broker the devices publish to. The bench broker on this Pi only has a mutual-TLS listener (port 8883):
# give the service a client certificate signed by the CA the broker trusts. See cloud/deploy/README.md.
IOTCLOUD_MQTT_HOST=127.0.0.1
IOTCLOUD_MQTT_PORT=8883
IOTCLOUD_MQTT_CA=/etc/iotcloud/certs/ca.crt
IOTCLOUD_MQTT_CERT=/etc/iotcloud/certs/cloud.crt
IOTCLOUD_MQTT_KEY=/etc/iotcloud/certs/cloud.key
# For a plain local broker (development) leave the three certificate lines out and use port 1883.
