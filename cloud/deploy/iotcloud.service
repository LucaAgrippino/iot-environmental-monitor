[Unit]
Description=IoT Environmental Monitor cloud (API, ingest, web app)
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=iotcloud
Group=iotcloud
EnvironmentFile=/etc/iotcloud/iotcloud.env
WorkingDirectory=/var/lib/iotcloud
ExecStart=/opt/iotcloud/venv/bin/python -m uvicorn --factory iotcloud.api:app --host 127.0.0.1 --port 8000 --no-server-header
Restart=on-failure
RestartSec=5
# The Pi 3 has 1 GB of RAM: a runaway process must not take the broker or the SSH session with it
MemoryMax=300M
# State (database, firmware images) lives in /var/lib/iotcloud and nowhere else is writable
StateDirectory=iotcloud
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
