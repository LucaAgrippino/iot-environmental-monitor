[submodule "firmware/external-library/freertos-kernel"]
	path = vendor/freertos-kernel
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
[submodule "vendor/coreMQTT"]
	path = vendor/coreMQTT
	url = https://github.com/FreeRTOS/coreMQTT.git
[submodule "vendor/mbedtls"]
	path = vendor/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
[submodule "vendor/lvgl"]
	path = vendor/lvgl
	url = https://github.com/lvgl/lvgl.git
	branch = release/v8.3
